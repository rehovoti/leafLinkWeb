# Leaflink Environment Variables Template
# Copy this to .env and fill in with your actual values

# ===== DATABASE CONFIGURATION =====
DB_USER=leaflink_user
DB_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
DB_NAME=leaflink_db
DATABASE_URL=postgresql://leaflink_user:GENERATE_SECURE_PASSWORD_HERE@db:5432/leaflink_db

# ===== PGADMIN CONFIGURATION =====
PGADMIN_EMAIL=admin@leaflink.garden
PGADMIN_PASSWORD=GENERATE_SECURE_PASSWORD_HERE

# ===== FASTAPI JWT SETTINGS =====
# Generate with: openssl rand -hex 32
SECRET_KEY=GENERATE_32_BYTE_HEX_STRING_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ===== GOOGLE OAUTH (Optional - for authentication) =====
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=https://leaflink.garden/api/auth/callback

# ===== DEPLOYMENT NOTES =====
# 1. Generate DB_PASSWORD and PGADMIN_PASSWORD:
#    openssl rand -base64 16
#
# 2. Generate SECRET_KEY:
#    openssl rand -hex 32
#
# 3. Update GOOGLE_* variables if using authentication
#    Leave them as placeholders if not using OAuth yet
#
# 4. Ensure DATABASE_URL matches DB_USER, DB_PASSWORD, and DB_NAME
#
# 5. Never commit this file to git - it contains secrets!
